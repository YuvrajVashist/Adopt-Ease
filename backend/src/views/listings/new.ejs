<%- layout('layouts/boilerplate', { title: 'List a pet | AdoptEase' }) %>

<section class="page-hero page-hero-short">

    <div class="container page-hero-content">

        <span class="eyebrow eyebrow-light">
            Help them find their person
        </span>

        <h1>
            Give a pet a <em>fresh start.</em>
        </h1>

        <p>
            A thoughtful profile helps the right person
            picture life with your animal.
        </p>

    </div>

</section>

<section class="section form-page-section">

    <div class="container form-layout">

        <aside class="form-aside">

            <span class="eyebrow">Before you begin</span>

            <h2>Tell their story.</h2>

            <p class="muted-copy">
                Share accurate details and a clear photo.
                Be open about their personality, health,
                and the kind of home they need.
            </p>

            <div class="tip-card">
                <span class="tip-icon">✦</span>
                <strong>A helpful tip</strong>

                <p>
                    Specific details help adopters understand
                    whether they can offer the right environment.
                </p>
            </div>

            <a href="/listings" class="text-link">
                Back to all pets →
            </a>

        </aside>

        <div class="form-card">

            <div class="form-card-heading">
                <span class="step-pill">NEW LISTING</span>
                <h2>Pet details</h2>
                <p>Fields marked with * are required.</p>
            </div>

            <form action="/listings" method="POST" class="app-form">

                <div class="form-grid">

                    <div class="field">
                        <label for="name">Pet's name *</label>
                        <input
                            id="name"
                            name="name"
                            type="text"
                            maxlength="80"
                            placeholder="e.g. Milo"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="species">Animal type *</label>

                        <select id="species" name="species" required>
                            <option value="" disabled selected>Select type</option>
                            <option value="Dog">Dog</option>
                            <option value="Cat">Cat</option>
                            <option value="Bird">Bird</option>
                            <option value="Rabbit">Rabbit</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="breed">Breed *</label>
                        <input
                            id="breed"
                            name="breed"
                            type="text"
                            maxlength="80"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="age">Age in years *</label>
                        <input
                            id="age"
                            name="age"
                            type="number"
                            min="0"
                            max="100"
                            step="0.1"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="gender">Gender *</label>

                        <select id="gender" name="gender" required>
                            <option value="" disabled selected>Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Unknown">Unknown</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="location">Location *</label>
                        <input
                            id="location"
                            name="location"
                            type="text"
                            maxlength="120"
                            placeholder="City, State"
                            required
                        >
                    </div>

                    <div class="field field-span-2">
                        <label for="image">Photo URL</label>
                        <input
                            id="image"
                            name="image"
                            type="url"
                            placeholder="https://example.com/pet-photo.jpg"
                        >
                        <small>You can leave this blank.</small>
                    </div>

                    <div class="field">
                        <label for="healthStatus">Health status</label>
                        <input
                            id="healthStatus"
                            name="healthStatus"
                            type="text"
                            maxlength="160"
                            placeholder="e.g. Healthy"
                        >
                    </div>

                    <div class="field">
                        <label for="vaccinationStatus">Vaccinated?</label>

                        <select id="vaccinationStatus" name="vaccinationStatus">
                            <option value="false" selected>No / Not confirmed</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>

                    <div class="field field-span-2">
                        <label for="description">About this pet *</label>

                        <textarea
                            id="description"
                            name="description"
                            rows="6"
                            minlength="10"
                            maxlength="2000"
                            placeholder="Describe their personality, routine, needs, and ideal home..."
                            required
                        ></textarea>

                        <small>10 to 2,000 characters.</small>
                    </div>

                </div>

                <div class="form-footer">

                    <a href="/listings" class="button button-outline">
                        Cancel
                    </a>

                    <button type="submit" class="button button-primary">
                        Publish listing ↗
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>