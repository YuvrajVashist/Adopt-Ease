<%- layout('layouts/boilerplate', { title: `${listing.name} | AdoptEase` }) %>

<section class="section pet-detail-section">

    <div class="container">

        <div class="breadcrumb">
            <a href="/listings">Find a pet</a>
            <span>/</span>
            <span><%= listing.name %></span>
        </div>

        <div class="pet-detail-grid">

            <div class="detail-photo-wrap">

                <img
                    class="detail-photo"
                    src="<%= listing.images?.[0] || 'https://placehold.co/1000x1000/e9eee7/315b45?text=Pet+photo' %>"
                    alt="<%= listing.name %>"
                >

                <span class="detail-photo-tag">
                    A new friend awaits
                </span>

            </div>

            <div class="detail-content">

                <div class="detail-kicker">
                    <span class="availability-dot"></span>
                    <%= listing.adoptionStatus %>
                    <span class="dot-separator">·</span>
                    <%= listing.species %>
                </div>

                <h1 class="detail-title">
                    <%= listing.name %>
                    <span class="detail-heart">♡</span>
                </h1>

                <p class="detail-breed">
                    <%= listing.breed %>
                </p>

                <div class="detail-facts">

                    <div>
                        <span>AGE</span>
                        <strong><%= listing.age %> years</strong>
                    </div>

                    <div>
                        <span>GENDER</span>
                        <strong><%= listing.gender %></strong>
                    </div>

                    <div>
                        <span>LOCATION</span>
                        <strong><%= listing.location %></strong>
                    </div>

                </div>

                <div class="detail-description">
                    <h2>A little about <%= listing.name %></h2>
                    <p><%= listing.description %></p>
                </div>

                <div class="health-note">
                    <div>
                        <span class="health-symbol">✚</span>

                        <span>
                            <strong>Health information</strong>

                            <small>
                                <%= listing.healthStatus || 'Not specified' %>
                                · Vaccinated:
                                <%= listing.vaccinationStatus ? 'Yes' : 'No / Not confirmed' %>
                            </small>
                        </span>
                    </div>
                </div>

                <div class="owner-card">

                    <div class="owner-avatar">♧</div>

                    <div>
                        <span class="mini-label">LISTED BY</span>

                        <strong>
                            <%= listing.owner?.displayName || listing.owner?.email || 'Pet owner' %>
                        </strong>

                        <small>
                            <%= listing.owner?.phone || 'Contact details unavailable' %>
                        </small>
                    </div>

                </div>

                <div class="detail-actions">

                    <% if (
                        currentUser &&
                        listing.owner &&
                        String(listing.owner._id) === String(currentUser._id)
                    ) { %>

                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="button button-primary"
                        >
                            Edit listing
                        </a>

                        <form
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            method="POST"
                            onsubmit="return confirm('Delete this pet listing and its applications? This cannot be undone.');"
                        >
                            <button type="submit" class="button button-danger">
                                Delete listing
                            </button>
                        </form>

                    <% } else if (listing.adoptionStatus === 'Available') { %>

                        <% if (currentUser) { %>

                            <a
                                href="/adoptions/new/<%= listing._id %>"
                                class="button button-primary"
                            >
                                Apply to adopt ↗
                            </a>

                        <% } else { %>

                            <a href="/user/login" class="button button-primary">
                                Log in to apply ↗
                            </a>

                        <% } %>

                    <% } else { %>

                        <span class="status-message">
                            Applications are closed for this pet.
                        </span>

                    <% } %>

                </div>

                <a href="/listings" class="back-link">
                    ← Back to all animals
                </a>

            </div>

        </div>

    </div>

</section>