<%- layout('layouts/boilerplate', { title: `Edit ${listing.name} | AdoptEase` }) %>

<section class="page-hero page-hero-short">

    <div class="container page-hero-content">

        <span class="eyebrow eyebrow-light">
            Keep their profile up to date
        </span>

        <h1>
            Update <em><%= listing.name %>'s</em> story.
        </h1>

        <p>
            Make sure potential adopters have the latest information.
        </p>

    </div>

</section>

<section class="section form-page-section">

    <div class="container form-layout">

        <aside class="form-aside">

            <span class="eyebrow">Listing editor</span>

            <h2>Little updates matter.</h2>

            <p class="muted-copy">
                Accurate age, health, and location details
                help adopters make informed decisions.
            </p>

            <div class="tip-card">
                <span class="tip-icon">♡</span>
                <strong>Currently listed</strong>

                <p>
                    <%= listing.name %> ·
                    <%= listing.species %> ·
                    <%= listing.location %>
                </p>
            </div>

            <a href="/listings/<%= listing._id %>" class="text-link">
                View listing →
            </a>

        </aside>

        <div class="form-card">

            <div class="form-card-heading">
                <span class="step-pill">EDIT LISTING</span>
                <h2>Pet details</h2>
                <p>Update the fields below and save your changes.</p>
            </div>

            <form
                action="/listings/<%= listing._id %>?_method=PUT"
                method="POST"
                class="app-form"
            >

                <div class="form-grid">

                    <div class="field">
                        <label for="name">Pet's name *</label>
                        <input
                            id="name"
                            name="name"
                            type="text"
                            maxlength="80"
                            value="<%= listing.name %>"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="species">Animal type *</label>

                        <select id="species" name="species" required>
                            <% ['Dog','Cat','Bird','Rabbit','Other'].forEach((value) => { %>
                                <option
                                    value="<%= value %>"
                                    <%= listing.species === value ? 'selected' : '' %>
                                >
                                    <%= value %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="field">
                        <label for="breed">Breed *</label>
                        <input
                            id="breed"
                            name="breed"
                            type="text"
                            maxlength="80"
                            value="<%= listing.breed %>"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="age">Age in years *</label>
                        <input
                            id="age"
                            name="age"
                            type="number"
                            min="0"
                            max="100"
                            step="0.1"
                            value="<%= listing.age %>"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="gender">Gender *</label>

                        <select id="gender" name="gender" required>
                            <% ['Male','Female','Unknown'].forEach((value) => { %>
                                <option
                                    value="<%= value %>"
                                    <%= listing.gender === value ? 'selected' : '' %>
                                >
                                    <%= value %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="field">
                        <label for="location">Location *</label>
                        <input
                            id="location"
                            name="location"
                            type="text"
                            maxlength="120"
                            value="<%= listing.location %>"
                            required
                        >
                    </div>

                    <div class="field field-span-2">
                        <label for="image">Photo URL</label>
                        <input
                            id="image"
                            name="image"
                            type="url"
                            value="<%= listing.images?.[0] || '' %>"
                        >
                        <small>Leave blank to remove the current photo.</small>
                    </div>

                    <div class="field">
                        <label for="healthStatus">Health status</label>
                        <input
                            id="healthStatus"
                            name="healthStatus"
                            type="text"
                            maxlength="160"
                            value="<%= listing.healthStatus || '' %>"
                        >
                    </div>

                    <div class="field">
                        <label for="vaccinationStatus">Vaccinated?</label>

                        <select id="vaccinationStatus" name="vaccinationStatus">
                            <option value="false" <%= !listing.vaccinationStatus ? 'selected' : '' %>>
                                No / Not confirmed
                            </option>

                            <option value="true" <%= listing.vaccinationStatus ? 'selected' : '' %>>
                                Yes
                            </option>
                        </select>
                    </div>

                    <div class="field field-span-2">
                        <label for="description">About this pet *</label>

                        <textarea
                            id="description"
                            name="description"
                            rows="6"
                            minlength="10"
                            maxlength="2000"
                            required
                        ><%= listing.description %></textarea>
                    </div>

                </div>

                <div class="form-footer">

                    <a
                        href="/listings/<%= listing._id %>"
                        class="button button-outline"
                    >
                        Cancel
                    </a>

                    <button type="submit" class="button button-primary">
                        Save changes ✓
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>