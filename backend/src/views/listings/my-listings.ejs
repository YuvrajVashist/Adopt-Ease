<%- layout('layouts/boilerplate', { title: 'My listings | AdoptEase' }) %>

<section class="page-hero page-hero-compact">
    <div class="container page-hero-content">

        <span class="eyebrow eyebrow-light">
            Your community contribution
        </span>

        <h1>Pets you've <em>shared.</em></h1>

        <p>
            Keep track of the animals you've listed
            and their adoption status.
        </p>

    </div>
</section>

<section class="section listings-page-section">
    <div class="container">

        <div class="listing-toolbar-heading">

            <div>
                <span class="eyebrow">Your listings</span>

                <h2 class="section-title section-title-small">
                    Your pet <em>board.</em>
                </h2>
            </div>

            <a href="/listings/new" class="button button-primary">
                + Add a pet
            </a>

        </div>

        <% if (!listings.length) { %>

            <div class="empty-state empty-state-large">

                <div class="empty-illustration">🏡</div>

                <span class="eyebrow">A place to start</span>

                <h2>You haven't listed a pet yet.</h2>

                <p>
                    Create a thoughtful profile and help
                    an animal find a loving home.
                </p>

                <a href="/listings/new" class="button button-primary">
                    Create your first listing
                </a>

            </div>

        <% } else { %>

            <div class="pet-grid">

                <% listings.forEach((pet) => { %>

                    <article class="pet-card">

                        <a
                            href="/listings/<%= pet._id %>"
                            class="pet-card-image-link"
                        >

                            <img
                                class="pet-card-image"
                                src="<%= pet.images?.[0] || 'https://placehold.co/800x600/e9eee7/315b45?text=Pet+photo' %>"
                                alt="<%= pet.name %>"
                                loading="lazy"
                            >

                            <span class="image-badge">
                                <%= pet.species %>
                            </span>

                        </a>

                        <div class="pet-card-body">

                            <div class="pet-card-topline">

                                <span class="pet-location">
                                    ⌖ <%= pet.location %>
                                </span>

                                <span class="status-chip status-<%= pet.adoptionStatus.toLowerCase() %>">
                                    <%= pet.adoptionStatus %>
                                </span>

                            </div>

                            <h3>
                                <a href="/listings/<%= pet._id %>">
                                    <%= pet.name %>
                                </a>
                            </h3>

                            <p class="pet-card-subtitle">
                                <%= pet.breed %> · <%= pet.age %> years
                            </p>

                            <div class="card-button-row">

                                <a
                                    href="/listings/<%= pet._id %>"
                                    class="button button-outline button-small"
                                >
                                    View
                                </a>

                                <a
                                    href="/listings/<%= pet._id %>/edit"
                                    class="button button-primary button-small"
                                >
                                    Edit
                                </a>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </div>
</section>