<%- layout('layouts/boilerplate', { title: 'Log in | AdoptEase' }) %>

<section class="auth-section">

    <div class="container auth-layout">

        <div class="auth-art auth-art-login">

            <span class="eyebrow eyebrow-light">Welcome back</span>

            <div class="auth-illustration">🐕</div>

            <h1>
                Good to see<br>
                you <em>again.</em>
            </h1>

            <p>
                Your next chapter with a four-legged friend
                could be one click away.
            </p>

            <div class="auth-art-foot">
                ♡ Every connection starts somewhere.
            </div>

        </div>

        <div class="auth-panel">

            <div class="auth-panel-heading">
                <span class="eyebrow">Your account</span>
                <h2>Log in to AdoptEase</h2>
                <p>Pick up where you left off.</p>
            </div>

            <form
                action="/login"
                method="POST"
                class="app-form auth-form"
            >

                <div class="field">
                    <label for="email">Email address</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="email"
                        placeholder="you@example.com"
                        required
                    >
                </div>

                <div class="field">
                    <label for="password">Password</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="current-password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <button
                    type="submit"
                    class="button button-primary button-block"
                >
                    Log in →
                </button>

            </form>

            <p class="auth-switch">
                New to AdoptEase?
                <a href="/register">Create an account</a>
            </p>

        </div>

    </div>

</section>