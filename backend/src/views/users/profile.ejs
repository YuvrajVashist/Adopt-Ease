<%- layout('layouts/boilerplate', { title: 'My account | AdoptEase' }) %>

<section class="page-hero page-hero-compact">

    <div class="container page-hero-content">

        <span class="eyebrow eyebrow-light">
            Your AdoptEase space
        </span>

        <h1>
            Welcome home,
            <em><%= user.displayName || user.email %>.</em>
        </h1>

        <p>
            Your adoption activity, listings, and account details
            in one place.
        </p>

    </div>

</section>

<section class="section dashboard-section">

    <div class="container">

        <div class="profile-card">

            <div class="profile-avatar">
                <%= (user.displayName || user.email || 'A').charAt(0).toUpperCase() %>
            </div>

            <div class="profile-main">

                <span class="eyebrow">ACCOUNT DETAILS</span>

                <h2>
                    <%= user.displayName || 'AdoptEase member' %>
                </h2>

                <p><%= user.email %></p>

            </div>

            <div class="profile-contact">

                <span>
                    <strong>Phone</strong>
                    <%= user.phone || 'Not provided' %>
                </span>

                <span>
                    <strong>Location</strong>
                    <%= user.address || 'Not provided' %>
                </span>

            </div>

            <span class="role-chip">
                <%= user.role || 'Member' %>
            </span>

        </div>

        <div class="dashboard-heading">

            <div>
                <span class="eyebrow">Your activity</span>

                <h2 class="section-title section-title-small">
                    Your <em>dashboard.</em>
                </h2>
            </div>

        </div>

        <div class="dashboard-grid">

            <a href="/listings/my-listings" class="dashboard-card">
                <span class="dashboard-icon">⌂</span>
                <span class="dashboard-card-kicker">FOR PET OWNERS</span>
                <h3>My listings</h3>
                <p>View and manage the animals you've listed.</p>
                <span class="dashboard-arrow">↗</span>
            </a>

            <a href="/adoptions/my-applications" class="dashboard-card">
                <span class="dashboard-icon">♡</span>
                <span class="dashboard-card-kicker">YOUR ADOPTION JOURNEY</span>
                <h3>My applications</h3>
                <p>Keep track of the pets you've applied to adopt.</p>
                <span class="dashboard-arrow">↗</span>
            </a>

            <a href="/adoptions/received" class="dashboard-card">
                <span class="dashboard-icon">✉</span>
                <span class="dashboard-card-kicker">FOR PET OWNERS</span>
                <h3>Received applications</h3>
                <p>Review people interested in adopting your pets.</p>
                <span class="dashboard-arrow">↗</span>
            </a>

            <a href="/listings/new" class="dashboard-card dashboard-card-accent">
                <span class="dashboard-icon">＋</span>
                <span class="dashboard-card-kicker">MAKE A DIFFERENCE</span>
                <h3>List a pet</h3>
                <p>Help an animal take the next step towards a home.</p>
                <span class="dashboard-arrow">↗</span>
            </a>

        </div>

    </div>

</section>