<%- layout('layouts/boilerplate', { title: 'Create an account | AdoptEase' }) %>

<section class="auth-section">

    <div class="container auth-layout auth-layout-register">

        <div class="auth-art auth-art-register">

            <span class="eyebrow eyebrow-light">Join the circle</span>

            <div class="auth-illustration">🐾</div>

            <h1>
                Make room<br>
                for <em>more love.</em>
            </h1>

            <p>
                Create an account to list animals, apply to adopt,
                and keep every conversation in one place.
            </p>

            <div class="auth-art-foot">
                ✦ Good things happen when we show up.
            </div>

        </div>

        <div class="auth-panel">

            <div class="auth-panel-heading">
                <span class="eyebrow">Start here</span>
                <h2>Create your account</h2>
                <p>A few details and you're part of the community.</p>
            </div>

            <form
                action="/register"
                method="POST"
                class="app-form auth-form"
            >

                <div class="field">
                    <label for="username">Full name</label>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        autocomplete="name"
                        minlength="3"
                        maxlength="80"
                        placeholder="Your name"
                        required
                    >
                </div>

                <div class="field">
                    <label for="email">Email address</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="email"
                        placeholder="you@example.com"
                        required
                    >
                </div>

                <div class="form-grid auth-two-col">

                    <div class="field">
                        <label for="phone">Phone number</label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            autocomplete="tel"
                            maxlength="20"
                            required
                        >
                    </div>

                    <div class="field">
                        <label for="password">Password</label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            autocomplete="new-password"
                            minlength="8"
                            placeholder="At least 8 characters"
                            required
                        >
                    </div>

                </div>

                <div class="field">
                    <label for="address">Address / city</label>

                    <textarea
                        id="address"
                        name="address"
                        rows="3"
                        maxlength="300"
                        autocomplete="street-address"
                        placeholder="Where are you based?"
                        required
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="button button-primary button-block"
                >
                    Create account →
                </button>

            </form>

            <p class="auth-switch">
                Already have an account?
                <a href="/login">Log in</a>
            </p>

        </div>

    </div>

</section>