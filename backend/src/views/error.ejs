<%- layout('layouts/boilerplate', { title: `${status || 500} | AdoptEase` }) %>

<section class="error-page">

    <div class="container error-content">

        <div class="error-mark">!</div>

        <span class="eyebrow">A small detour</span>

        <h1><%= status || 500 %></h1>

        <h2><%= message || 'Something went wrong.' %></h2>

        <p>
            That wasn't supposed to happen.
            Head back home or try another page.
        </p>

        <div class="hero-actions">

            <a href="/" class="button button-primary">
                Go home
            </a>

            <a href="/listings" class="button button-outline">
                Browse pets
            </a>

        </div>

    </div>

</section>